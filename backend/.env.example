SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (Railway)
# Local: postgresql+asyncpg://clinic_user:password@localhost:5432/clinic_db
# Railway: postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis (Railway)
# Local: redis://localhost:6379
# Railway: redis://redis.railway.internal:6379
REDIS_URL=redis://host:6379

EMAILS_ENABLED=True
RESEND_API_KEY=re_your_api_key_here
EMAILS_FROM=noreply@medlinks.uk

FRONTEND_URL=https://medlinks.uk

# Seed data (set to "true" ONLY for initial setup, then set back to "false")
ALLOW_SEED=false
ADMIN_PASSWORD=Admin123!
